# python
__pycache__/
*.py[cod]

# packaging
build/
dist/
*.egg-info/

# generated by tools/run_all_examples.sh
run_extracted_examples.sh

# Shape2SAS output. It is written into the working directory and into one
# directory per model, whose names the user chooses, so it is matched by
# extension rather than by name.
# Remove all of it with:  git clean -Xfd
*.log
*.pdb
*.dat
*.ses
*.png
*.pdf
points_*.txt

# except the figures used in the README
!examples/**
